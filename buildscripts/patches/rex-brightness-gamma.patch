diff --git a/app/src/main/kotlin/xyz/mpv/rex/utils/BrightnessScale.kt b/app/src/main/kotlin/xyz/mpv/rex/utils/BrightnessScale.kt
new file mode 100644
index 0000000..127cd43
--- /dev/null
+++ b/app/src/main/kotlin/xyz/mpv/rex/utils/BrightnessScale.kt
@@ -0,0 +1,42 @@
+package xyz.mpv.rex.utils
+
+import kotlin.math.pow
+
+/**
+ * Brightness mapping helpers.
+ *
+ * The framework keeps two brightness spaces:
+ * - **gamma space**: `Settings.System.SCREEN_BRIGHTNESS` (0..255) and everything the user sees.
+ * - **linear space**: `WindowManager.LayoutParams.screenBrightness` (0f..1f), applied to the panel.
+ *
+ * Mixing them collapsed the usable range into the bottom fifth of the slider. Two more gotchas:
+ *
+ * 1. The display caps the applied brightness by ambient light
+ *    (`DisplayDeviceConfig.HdrBrightnessData.mMaxBrightnessLimits`, keyed by lux, step lookup).
+ *    Anything above the cap is silently clamped, which left the top of the slider dead.
+ * 2. The AOSP `convertGammaToLinear` curve is shallower than a real perceptual curve, so the slider
+ *    still felt top-heavy. A plain 2.2 gamma tracks perceived brightness closely.
+ */
+object BrightnessScale {
+  private const val GAMMA = 2.2f
+
+  /** Slider position (0..1, perceptually uniform) to a linear luminance fraction (0..1). */
+  fun gammaToLinear(gamma: Float): Float = gamma.coerceIn(0f, 1f).pow(GAMMA)
+
+  fun linearToGamma(linear: Float): Float = linear.coerceIn(0f, 1f).pow(1f / GAMMA)
+
+  /**
+   * Highest linear brightness the display will actually apply at this ambient light level.
+   * Mirrors `DisplayDeviceConfig.HdrBrightnessData.mMaxBrightnessLimits` (step lookup, in lux).
+   */
+  fun maxLinearBrightness(ambientLux: Float): Float = when {
+    ambientLux < 100f -> 0.35f
+    ambientLux < 1000f -> 0.5f
+    ambientLux < 10000f -> 0.75f
+    else -> 1f
+  }
+
+  /** Slider position plus ambient light to the value handed to the window. */
+  fun outputBrightness(gamma: Float, ambientLux: Float): Float =
+    (gammaToLinear(gamma) * maxLinearBrightness(ambientLux)).coerceIn(0f, 1f)
+}
