--- /dev/null
+++ b/app/src/main/kotlin/xyz/mpv/rex/utils/BrightnessScale.kt
@@ -0,0 +1,27 @@
+package xyz.mpv.rex.utils
+
+import kotlin.math.sqrt
+
+/**
+ * Converts between the two brightness representations the Android framework uses.
+ *
+ * - **gamma space**: `Settings.System.SCREEN_BRIGHTNESS` (0..255) and everything shown to the user
+ *   (the slider percentage). Roughly perceptually uniform.
+ * - **linear space**: `WindowManager.LayoutParams.screenBrightness` (0f..1f), which the display
+ *   power controller feeds straight into the panel luminance.
+ *
+ * Mixing the two collapses the usable range into the bottom fifth of the slider: a value of 0.2
+ * read from Settings and written back as a linear override lands around 200 nits on a panel that
+ * tops out near 900. Mirrors `android.util.BrightnessUtils`, which is a hidden API.
+ */
+object BrightnessScale {
+  fun gammaToLinear(gamma: Float): Float {
+    val v = gamma.coerceIn(0f, 1f)
+    return if (v <= 0.5f) 2f * v * v else 1f - 2f * (1f - v) * (1f - v)
+  }
+
+  fun linearToGamma(linear: Float): Float {
+    val v = linear.coerceIn(0f, 1f)
+    return if (v <= 0.5f) sqrt(0.5f * v) else 1f - sqrt(0.5f * (1f - v))
+  }
+}
