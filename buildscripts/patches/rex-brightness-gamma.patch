--- /dev/null
+++ b/app/src/main/kotlin/xyz/mpv/rex/utils/BrightnessScale.kt
@@ -0,0 +1,37 @@
+package xyz.mpv.rex.utils
+
+import kotlin.math.pow
+
+/**
+ * Brightness mapping helpers.
+ *
+ * The framework keeps two brightness spaces:
+ * - **gamma space**: `Settings.System.SCREEN_BRIGHTNESS` (0..255) and everything the user sees.
+ * - **linear space**: `WindowManager.LayoutParams.screenBrightness` (0f..1f), applied to the panel.
+ *
+ * Mixing them collapsed the usable range into the bottom fifth of the slider.
+ *
+ * Two more things this fixes:
+ *
+ * 1. The display pipeline only applies brightness up to [MAX_LINEAR]. Above it the value is
+ *    clamped (the panel's SDR range ends at the HBM transition, 0.49791616, and the remaining
+ *    headroom is only unlocked in direct sunlight), which used to leave the top of the slider
+ *    dead. Scaling by [MAX_LINEAR] keeps the whole slider live and deterministic.
+ * 2. The AOSP `convertGammaToLinear` curve is shallower than a real perceptual curve, so the
+ *    slider still felt top-heavy. A plain 2.2 gamma tracks perceived brightness closely.
+ */
+object BrightnessScale {
+  private const val GAMMA = 2.2f
+
+  /** Highest linear brightness the display actually applies. Fixed, not ambient dependent. */
+  private const val MAX_LINEAR = 0.5f
+
+  /** Slider position (0..1, perceptually uniform) to a linear luminance fraction (0..1). */
+  fun gammaToLinear(gamma: Float): Float = gamma.coerceIn(0f, 1f).pow(GAMMA)
+
+  fun linearToGamma(linear: Float): Float = linear.coerceIn(0f, 1f).pow(1f / GAMMA)
+
+  /** Slider position to the value handed to the window. 100% maps to [MAX_LINEAR]. */
+  fun outputBrightness(gamma: Float): Float =
+    (gammaToLinear(gamma) * MAX_LINEAR).coerceIn(0f, 1f)
+}
